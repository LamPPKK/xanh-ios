{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lamppkk.github.io/xanh-ios/blocker-manifest-v1.schema.json",
  "title": "Xanh blocker manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "version", "sourceCommits", "artifacts", "minimumAppVersion", "createdAt"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "version": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[0-9]+(?:\\.[0-9]+)+$" },
        "sourceCommits": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["identifier", "url", "sha256"],
            "properties": {
              "identifier": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
              "url": { "type": "string", "format": "uri", "pattern": "^https://" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "minimumAppVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "signature": { "type": "string", "minLength": 40, "maxLength": 128 }
  }
}
